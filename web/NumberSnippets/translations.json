 des fragments de nombre. Les fragments de nombre vous permettent de récupérer la forme plurielle correcte d'une chaîne localisée en fonction d'un nombre. Par exemple, ils peuvent choisir automatiquement entre « 1 fichier » et « 2 fichiers » selon les règles de pluralisation de la langue.","status":"Approved"},{"lang":"pl","text":"To demo pokazuje użycie fragmentów liczbowych. Fragmenty liczbowe pozwalają pobrać poprawną formę liczby mnogiej zlokalizowanego ciągu na podstawie liczby. Na przykład mogą automatycznie wybrać między „1 plik” a „2 pliki” zgodnie z zasadami tworzenia liczby mnogiej w danym języku.","status":"Approved"}]},{"name":"ElementClassName","value":""},{"name":"ElementLabelClassName","value":""},{"name":"Hint","value":""},{"name":"HTML","value":""}],"elements":[{"name":"Font","unit":"WEBLib.Graphics","class":"TFont","properties":[]},{"name":"Margins","unit":"WEBLib.Controls","class":"TMargins","properties":[]}]},{"name":"lblTitle","unit":"WEBLib.StdCtrls","class":"TLabel","properties":[{"name":"Caption","value":"Number snippet demo","translations":[{"lang":"nl","text":"Demo van nummersnippers","status":"Approved"},{"lang":"de","text":"Demo für Zahlenschnipsel","status":"Approved"},{"lang":"fr","text":"Démo de fragments de nombre","status":"Approved"},{"lang":"pl","text":"Demo fragmentów liczbowych","status":"Approved"}]},{"name":"ElementClassName","value":""},{"name":"ElementLabelClassName","value":""},{"name":"Hint","value":""},{"name":"HTML","value":""}],"elements":[{"name":"Font","unit":"WEBLib.Graphics","class":"TFont","properties":[]},{"name":"Margins","unit":"WEBLib.Controls","class":"TMargins","properties":[]}]},{"name":"LocalizationEditor","unit":"WEBLib.TMSFNCLocalizationEditor","class":"TTMSFNCLocalizationEditor","properties":[{"name":"ElementClassName","value":""},{"name":"Hint","value":""},{"name":"Version","value":""}]},{"name":"sbCount","unit":"WEBLib.StdCtrls","class":"TSpinEdit","properties":[{"name":"ElementClassName","value":""},{"